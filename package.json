{
	"name": "portfolio-website",
	"version": "0.0.0",
	"private": true,
	"description": "Portfolio website - Vue 3 + Vite",
	"repository": "",
	"license": "MIT",
	"author": "",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"deploy": "npm run build && firebase deploy",
		"lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
		"lint:css": "stylelint \"**/*.css\" \"**/*.scss\" --allow-empty-input",
		"lint:css:fix": "stylelint \"**/*.css\" \"**/*.scss\" --fix",
		"lint:fix": "concurrently \"npm:lint:js:fix\" \"npm:lint:css:fix\" --names \"fix:\"",
		"lint:js": "eslint . --cache",
		"lint:js:fix": "eslint . --fix",
		"start": "vite",
		"tunnel": "concurrently \"npm:start\" \"npm:localtunnel\"",
		"localtunnel": "npx localtunnel --port 5173 --subdomain chrisv"
	},
	"dependencies": {
		"breakpoint-sass": "^3.0.0",
		"chart.js": "^4.4.0",
		"jquery": "^3.7.0",
		"skrollr": "^0.6.26",
		"sparkle": "git+https://github.com/cvaccarello/sparkle.git",
		"vue": "^3.4.0",
		"vue-chartjs": "^5.3.0",
		"vue-router": "^4.2.0"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.22.5",
		"@vitejs/plugin-vue": "^5.0.0",
		"concurrently": "^8.2.0",
		"eslint": "^8.43.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-prettier": "^4.2.1",
		"eslint-plugin-vue": "^9.19.0",
		"firebase-tools": "^13.0.0",
		"localtunnel": "^2.0.2",
		"postcss-scss": "^4.0.9",
		"prettier": "^2.8.8",
		"sass": "^1.64.0",
		"stylelint": "^15.9.0",
		"stylelint-config-standard": "^33.0.0",
		"stylelint-prettier": "^3.0.0",
		"vite": "^5.0.0",
		"vue-eslint-parser": "^9.4.0"
	},
	"engines": {
		"node": "16.* || >= 18"
	}
}
